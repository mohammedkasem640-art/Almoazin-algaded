<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="6dp">

    <!-- Top Header Line: Next Prayer Countdown + City Name -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/layout_notif_prayer_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_notif_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب 06:15 (يتبقى "
                android:textColor="@color/widget_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/chronometer_notif_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_prayer_close_paren"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=")"
                android:textColor="@color/widget_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="المغرب 06:15 (يتبقى 01:22:15)"
            android:textColor="@color/widget_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_notif_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="مكة المكرمة • ﷺ"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 5 Prayers Grid Row (All 5 Prayers visible at once) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/cell_notif_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:04"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/cell_notif_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:12"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/cell_notif_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:34"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/cell_notif_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:15"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/cell_notif_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:45"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Salawat Row in Notification Bar -->
    <LinearLayout
        android:id="@+id/layout_notif_salawat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_salawat_pill"
        android:layout_marginTop="5dp"
        android:paddingVertical="3dp"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/btn_notif_salawat_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gold_button"
            android:text="صلّ الآن ﷺ"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp" />

        <LinearLayout
            android:id="@+id/layout_notif_salawat_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة على النبي ﷺ: يتبقى "
                android:textColor="@color/widget_salawat_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/chronometer_notif_salawat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_salawat_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="الصلاة على النبي ﷺ: يتبقى 04:20"
            android:textColor="@color/widget_salawat_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingEnd="4dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
