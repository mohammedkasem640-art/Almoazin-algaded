<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_salawat_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- Header: Crescent + Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_standalone_salawat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="ﷺ الصلاة على النبي ﷺ"
            android:textColor="@color/widget_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_standalone_salawat_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="تذكير دوري"
            android:textColor="@color/widget_salawat_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Center Card: Cyan/Emerald Banner with Live Seconds Chronometer -->
    <LinearLayout
        android:id="@+id/card_salawat_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyan_banner"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوقت المتبقي للتذكير القادم:"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Chronometer
                android:id="@+id/chronometer_standalone_salawat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_standalone_salawat_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:20"
            android:textColor="@color/widget_gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Action Row: Play Now Button & Dhikr Phrase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/btn_standalone_salawat_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gold_button"
            android:text="صلّ الآن ﷺ"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp" />

        <TextView
            android:id="@+id/tv_standalone_salawat_dhikr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="اللهم صلّ وسلم على نبينا محمد"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:paddingStart="8dp" />
    </LinearLayout>

</LinearLayout>
