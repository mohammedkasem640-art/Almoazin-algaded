<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_salawat_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D3B2E"
    android:padding="12dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="الصلاة على النبي ﷺ"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="تذكير دائم"
            android:textColor="@color/widget_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Inner cyan bordered box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_salawat_notif_card"
        android:layout_marginTop="8dp"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوقت المتبقي للتذكير القادم:"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_notif_salawat_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="٠٤:٢٠"
            android:textColor="#00E5FF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginVertical="2dp" />

        <TextView
            android:id="@+id/tv_notif_salawat_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الموعد القادم: 11:38 م"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Action Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btn_notif_pray_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_gold_button"
            android:text="صلّ الآن ﷺ"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/tv_notif_salawat_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="الصوت: بالترتيب (صوت مختلف في كل مرة)"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </RelativeLayout>

</LinearLayout>
