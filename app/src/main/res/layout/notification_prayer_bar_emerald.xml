<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_emerald"
    android:padding="6dp">

    <!-- Top Header Line: Mosque Emblem, Next Prayer Countdown, City/Mosque Name -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/layout_notif_prayer_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_mosque_crescent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_notif_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب 06:15 (يتبقى "
                android:textColor="@color/widget_emerald_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/chronometer_notif_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_emerald_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_prayer_close_paren"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=")"
                android:textColor="@color/widget_emerald_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="المغرب 06:15 (يتبقى 01:22:15)"
            android:textColor="@color/widget_emerald_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_notif_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="مسجد الهدى • مكة المكرمة"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 5 Prayers Grid Row with Emerald Dome Arches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/cell_notif_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dome_emerald"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="@color/widget_emerald_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:04"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/cell_notif_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dome_emerald"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="@color/widget_emerald_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:12"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/cell_notif_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dome_emerald"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="@color/widget_emerald_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:35"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/cell_notif_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dome_emerald"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="@color/widget_emerald_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:15"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/cell_notif_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dome_emerald"
            android:paddingVertical="3dp"
            android:layout_marginHorizontal="1dp">

            <TextView
                android:id="@+id/tv_notif_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="@color/widget_emerald_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:45"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Salawat Bar with Live Seconds Chronometer and "صلّ الآن ﷺ" Button -->
    <LinearLayout
        android:id="@+id/layout_notif_salawat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_salawat_notif_card"
        android:paddingVertical="3dp"
        android:paddingHorizontal="6dp"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:id="@+id/layout_notif_salawat_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة على النبي ﷺ: يتبقى "
                android:textColor="@color/widget_emerald_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/chronometer_notif_salawat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_emerald_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_salawat_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاة على النبي ﷺ: يتبقى 14:50"
            android:textColor="@color/widget_emerald_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_notif_salawat_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صلّ الآن ﷺ"
            android:textColor="#05241D"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

</LinearLayout>
